-- NPC TRACK
local function getNPC()
	local closest, dist = nil, 200
	for _, v in pairs(workspace:GetDescendants()) do
		if v:IsA("Model") and not Players:GetPlayerFromCharacter(v) then
			local hum = v:FindFirstChildOfClass("Humanoid")
			local root = v:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 then
				local d = (root.Position - player.Character.HumanoidRootPart.Position).Magnitude
				if d < dist then
					dist = d
					closest = v
				end
			end
		end
	end
	return closest, dist
end

local tracking = false
trackButton.MouseButton1Click:Connect(function()
	tracking = not tracking
	trackButton.Text = "Track NPC: "..(tracking and "ON" or "OFF")
end)

RunService.RenderStepped:Connect(function()
	if tracking and player.Character then
		local npc, dist = getNPC()
		if npc then
			if dist <= 50 then
				label.TextColor3 = Color3.new(1,0,0)
			elseif dist <= 100 then
				label.TextColor3 = Color3.new(1,1,0)
			else
				label.TextColor3 = Color3.new(0,1,0)
			end
			label.Text = npc.Name.." ["..math.floor(dist).."m]"
		end
	end
end)

-- ESP
local esp = false
espButton.MouseButton1Click:Connect(function()
	esp = not esp
	espButton.Text = "ESP Players: "..(esp and "ON" or "OFF")
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			if esp then
				local h = Instance.new("Highlight", p.Character)
				h.FillColor = Color3.new(0,1,0)
			else
				for _, v in pairs(p.Character:GetChildren()) do
					if v:IsA("Highlight") then v:Destroy() end
				end
			end
		end
	end
end)

-- TELEPORT LIST FIX
local function refreshList()
	listFrame:ClearAllChildren()
	listLayout.Parent = listFrame
	
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player then
			if search.Text == "" or string.find(string.lower(p.Name), string.lower(search.Text)) then
				local b = Instance.new("TextButton")
				b.Size = UDim2.new(1,0,0,25)
				b.Text = p.Name
				b.BackgroundColor3 = Color3.fromRGB(30,30,30)
				b.TextColor3 = Color3.fromRGB(0,255,0)
				b.Parent = listFrame
				
				b.MouseButton1Click:Connect(function()
					if player.Character and p.Character then
						local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
						local targetRoot = p.Character:FindFirstChild("HumanoidRootPart")
						if myRoot and targetRoot then
							myRoot.CFrame = targetRoot.CFrame + Vector3.new(3,0,0)
						end
					end
				end)
			end
		end
	end
end

tpButton.MouseButton1Click:Connect(refreshList)
search:GetPropertyChangedSignal("Text"):Connect(refreshList)

-- DRAG
local dragging, dragStart, startPos
header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)
